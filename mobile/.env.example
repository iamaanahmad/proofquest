# Copy this file to .env and fill in your values.
# NEVER commit .env — it is gitignored.

# Appwrite backend
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<your-appwrite-project-id>
APPWRITE_DATABASE_ID=proofquest
# Server-side key — only needed for the setup script, NOT in the mobile app.
# If you expose this in the client it can be extracted from the APK bundle.
APPWRITE_API_KEY=<not-needed-in-mobile-client>

# Solana devnet RPC (get a free key at helius.dev)
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=<your-helius-api-key>

# On-chain program and token (pre-deployed on devnet — keep as-is unless you redeploy)
PROGRAM_ID=DmSc562EUuh9yvu2AmEupLLC8wQrXZGVSCZL61EpugvZ
TEST_USDC_MINT=<mint-address-from-scripts/setup-devnet.js>
